--============================================================
-- VARIABLES & STATE
--============================================================
local RageEnabled = false
local CurrentTarget = nil
local FollowConnection = nil
local ClickLoopThread = nil
local InVoid = false

-- Teamcheck State
local TeamcheckEnabled = false
local tempTeammates = {}

local SelectedWeapon = "Primary"
local WeaponSlotMap = {
    Primary = Enum.KeyCode.One,
    Secondary = Enum.KeyCode.Two,
    Melee = Enum.KeyCode.Three
}

-- Void Spam State
local VoidSpamEnabled = false
local TimeInVoid = 2
local ShootingInterval = 0.3
local NextVoidCycle = 0
local IsInVoidCycle = false

-- Desync Variables
local _dsRestoreRoot, _dsRestoreCF = nil, nil
local _dsRestoreVel, _dsRestoreRot = Vector3.zero, Vector3.zero
local _dsBound = false

--============================================================
-- TEAMCHECK LOGIC
--============================================================
local function SnapshotTeammates()
    table.clear(tempTeammates)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hum = plr.Character:FindFirstChild("Humanoid")
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            
            if hum and root and hum.Health > 0 then
                -- If they are within 30 studs, add them to the table
                if (root.Position - myRoot.Position).Magnitude <= 30 then
                    tempTeammates[plr] = true
                end
            end
        end
    end
end

local function IsTeammate(plr)
    if plr == LocalPlayer then return true end
    if TeamcheckEnabled and tempTeammates[plr] then return true end
    return false
end

--============================================================
-- DESYNC CAMERA SPOOF LOGIC
--============================================================
local function flushDesync()
    if _dsRestoreRoot and _dsRestoreRoot.Parent and _dsRestoreCF then
        pcall(function()
            _dsRestoreRoot.CFrame = _dsRestoreCF
            _dsRestoreRoot.AssemblyLinearVelocity = _dsRestoreVel
            _dsRestoreRoot.AssemblyAngularVelocity = _dsRestoreRot
        end)
    end
    _dsRestoreRoot, _dsRestoreCF = nil, nil
end

local function startDsRenderStep()
    if not _dsBound then
        _dsBound = true
        RunService:BindToRenderStep("__rb_ds_restore", Enum.RenderPriority.Camera.Value - 1, function()
            if _dsRestoreCF then flushDesync() end
        end)
    end
end

local function applyDesync(desyncCF)
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if myRoot then
        _dsRestoreRoot = myRoot
        _dsRestoreCF = myRoot.CFrame
        _dsRestoreVel = myRoot.AssemblyLinearVelocity
        _dsRestoreRot = myRoot.AssemblyAngularVelocity
        myRoot.CFrame = desyncCF
        return true
    end
    return false
end

