UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Z then
        RageToggle:Set(RageEnabled == false)
        RageEnabled = not RageEnabled
        if RageEnabled then StartFollowRage() else StopFollowRage() end
    end
end)

--============================================================
-- AUTO SHOOT LOGIC
--============================================================
local function StartClickingLoop()
    if ClickLoopThread then task.cancel(ClickLoopThread) end
    
    ClickLoopThread = task.spawn(function()
        while RageEnabled do
            -- Only shoot if we have a target and NOT in void cycle
            if CurrentTarget and CurrentTarget.Character and not IsInVoidCycle then
                local tChar = CurrentTarget.Character
                local tHum = tChar:FindFirstChild("Humanoid")
                
                if tHum and tHum.Health > 0 then
                    if not tChar:FindFirstChildOfClass("ForceField") then
                        pcall(function()
                            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                        end)
                    end
                end
            end
            task.wait(0.001)
        end
    end)
end

--============================================================
-- MAIN LOGIC (FOLLOW LOCK & VOID SPAM)
--============================================================
local function GetNearestPlayer()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local nearest = nil
    local shortest = 500

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            -- TEAMCHECK: Skip teammates
            if IsTeammate(plr) then continue end
            
            local hum = plr.Character:FindFirstChild("Humanoid")
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            
            if hum and root and hum.Health > 0 then
                local dist = (root.Position - myRoot.Position).Magnitude
                if dist < shortest then
                    shortest = dist
                    nearest = plr
                end
            end
        end
    end
    return nearest
end

local function EquipSelectedWeapon()
    local slotKey = WeaponSlotMap[SelectedWeapon]
    if slotKey then
        if not UserInputService:IsKeyDown(slotKey) then
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, slotKey, false, game)
                task.wait(0.05)
                VirtualInputManager:SendKeyEvent(false, slotKey, false, game)
            end)
        end
    end
end

function StartFollowRage()
    if FollowConnection then FollowConnection:Disconnect() end
    startDsRenderStep()
    StartClickingLoop()
    InVoid = false
    NextVoidCycle = tick() + TimeInVoid

    FollowConnection = RunService.RenderStepped:Connect(function()
        if not RageEnabled then return end

        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        if not myRoot or not myHum or myHum.Health <= 0 then return end

        -- Target logic
        if not CurrentTarget or not CurrentTarget.Character then
            CurrentTarget = GetNearestPlayer()
        end
        
        if CurrentTarget then
            local tHum = CurrentTarget.Character:FindFirstChild("Humanoid")
            if not tHum or tHum.Health <= 0 then
                CurrentTarget = GetNearestPlayer()
            end
        end

        local camera = Workspace.CurrentCamera

        if CurrentTarget and CurrentTarget.Character then
            local tRoot = CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
            local tHead = CurrentTarget.Character:FindFirstChild("Head")
            
            if tRoot and tHead then
                -- HANDLE VOID SPAM LOGIC
                if VoidSpamEnabled then
                    if tick() >= NextVoidCycle then
                        IsInVoidCycle = not IsInVoidCycle
                        if IsInVoidCycle then
                            -- Going to void
                            NextVoidCycle = tick() + TimeInVoid
                            myRoot.CFrame = CFrame.new(0, -10000, 0) -- Teleport to void
                            
                            if camera then
                                camera.CameraType = Enum.CameraType.Scriptable
                                local voidPos = Vector3.new(0, -10000, 0)
                                camera.CFrame = CFrame.new(voidPos, voidPos - Vector3.new(0, 1, 0))
                            end
                        else
                            -- Coming back to shoot
                            NextVoidCycle = tick() + ShootingInterval
                        end
                    end
                else
                    IsInVoidCycle = false
                end

                -- If not currently hiding in the void, glue to enemy and shoot
                if not IsInVoidCycle then
                    InVoid = false
                    local targetPos = tRoot.Position + Vector3.new(0, 1, 0)
                    myRoot.CFrame = CFrame.new(targetPos, tRoot.Position + tRoot.CFrame.LookVector)
                    
                    -- Shoot/Desync immediately
                    if not CurrentTarget.Character:FindFirstChildOfClass("ForceField") then
                        local aimPos = tHead.Position + tRoot.AssemblyLinearVelocity * 0.15
                        local desyncCF = CFrame.lookAt(targetPos, aimPos)
                        applyDesync(desyncCF)
                    end

                    if camera then
                        camera.CameraType = Enum.CameraType.Custom
                        local lookDownPos = myRoot.Position + Vector3.new(0, 5, 0)
                        camera.CFrame = CFrame.new(lookDownPos, lookDownPos - Vector3.new(0, 1, 0))
                    end
                end
            end
        else
            -- Target is dead or far away: Teleport to VOID
            IsInVoidCycle = false
            if not InVoid then
                InVoid = true
                myRoot.CFrame = CFrame.new(0, -10000, 0)
            end
            
            if camera then
                camera.CameraType = Enum.CameraType.Scriptable
                local voidPos = Vector3.new(0, -10000, 0)
                camera.CFrame = CFrame.new(voidPos, voidPos - Vector3.new(0, 1, 0))
            end
        end

        EquipSelectedWeapon()
    end)
end

function StopFollowRage()
    if FollowConnection then
        FollowConnection:Disconnect()
        FollowConnection = nil
    end
    if ClickLoopThread then
        task.cancel(ClickLoopThread)
        ClickLoopThread = nil
    end
    
    if Workspace.CurrentCamera then
        Workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
    end
    
    CurrentTarget = nil
    InVoid = false
    IsInVoidCycle = false
    flushDesync()
end
